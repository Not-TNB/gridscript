#ACKERMANN FUNCTION.

@width 9
@height 1

(1,1):START
(3,1):INPUT INT TO x
(5,1):INPUT INT TO y
(7,1):CALL ACK WITH ARGUMENTS x y
(9,1):PRINT

##ACK.

@width 19
@height 7

(1,1):START
(3,1):INPUT INT TO x
(5,1):INPUT INT TO y
(7,1):SWITCH !x
(7,3):INCREMENT y
(7,5):RETURN y
(9,1):SWITCH !y
(9,3):DECREMENT x
(9,5):CALL ACK WITH ARGUMENTS x 1
(9,7):RETURN
(11,1):DECREMENT y
(13,1):CALL ACK WITH ARGUMENTS x y GIVING z
(15,1):DECREMENT x
(17,1):CALL ACK WITH ARGUMENTS x z
(19,1):RETURN